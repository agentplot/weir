# The application tools, installed by proto and activated by the devenv
# shell: moon itself, and the Rust moon runs the crates' tasks with
# (.moon/toolchains.yml reads the rust pin). The system tools, proto among
# them, are devenv.nix's.
moon = "2.6.1"
# Rust's one pin: no other file names its version. The shell's activation
# puts this toolchain's bin first on PATH, and check-toolchain.sh holds
# rustc, cargo, clippy-driver and rustfmt to it (core.40).
rust = "1.98.1"
